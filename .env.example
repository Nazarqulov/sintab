BOT_TOKEN=<telegram_bot_token>
OWNER_TELEGRAM_ID=<sizning_telegram_id>
DATABASE_URL=postgresql+asyncpg://samsara_bot:samsara_bot@db:5432/samsara_bot
POSTGRES_PASSWORD=samsara_bot

# polling — lokal sinov (ochiq URL kerak emas); webhook — serverda (PUBLIC_BASE_URL bilan).
BOT_MODE=polling
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET_PATH=change-me-to-a-random-string

# Samsara Dashboard -> Settings -> Webhooks'dagi secret (base64). Lokal sinov uchun istalgan
# base64 qator: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SAMSARA_WEBHOOK_SECRET=
# Samsara Dashboard -> Settings -> API Tokens. Bo'sh bo'lsa mashina/haydovchi sinxroni o'tkazib yuboriladi.
SAMSARA_API_TOKEN=

DEFAULT_LANGUAGE=uz
# Alert vaqtlari shu zonada ko'rsatiladi (masalan AQSh parki uchun America/Chicago).
DEFAULT_TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
ENV=development
